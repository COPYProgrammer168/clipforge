# ClipForge on Render
# Values used by render.yaml. Set secrets in the Render dashboard, not here.

# -- Database ---------------------------------------------------------
# Persistent disk mounted at /var/data by render.yaml.
DATABASE_URL=file:/var/data/clipforge.db

# Alternative: Turso / hosted libSQL (no disk needed for the DB).
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# -- Blob uploads -----------------------------------------------------
# Optional. Only needed for browser file uploads (Vercel Blob).
# URL jobs work without it. Set it in the dashboard.
# BLOB_READ_WRITE_TOKEN=

# -- Worker -----------------------------------------------------------
# Faster-whisper model: tiny, base, small, medium, large-v3.
# base is a good CPU default; small/medium improve Khmer accuracy.
WHISPER_MODEL=base
# Optional CT2 folder; if missing, Khmer jobs fall back to WHISPER_MODEL.
WHISPER_MODEL_KM=/var/data/models/faster-whisper-base-khmer
# Keep downloaded Whisper weights on the disk across deploys.
HF_HOME=/var/data/hf-cache
POLL_SECONDS=3
# Scratch space for downloads/audio, cleaned after each job.
WORK_ROOT=/var/data/work
# Rendered clips, served by /clips/[...path].
CLIPS_ROOT=/var/data/clips
MIN_CLIP_SECONDS=16
MAX_CLIP_SECONDS=52
TARGET_CLIP_SECONDS=30

# -- Render setup -----------------------------------------------------
# Dockerfile and render.yaml are included.
# 1. Deploy the Blueprint (or create a Docker service manually and run
#    `node scripts/render-start.mjs`; it starts Next and the worker together).
# 2. Attach one persistent disk at /var/data. A disk limits the service to one
#    instance and causes brief downtime on deploys.
# 3. Run the schema push once in the Render Shell:
#    npm run db:push
# 4. Use at least 2 GB RAM (plan: standard); 512 MB will OOM.
# 5. Optional Khmer: build the CT2 model on the disk with
#    `npm run model:khmer` (needs transformers/torch), or leave the path unset.
