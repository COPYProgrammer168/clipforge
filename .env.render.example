# ClipForge on Render (Free + Turso + Vercel Blob)
# Render Free web services have an ephemeral filesystem and cannot attach disks.
# Set these values in the Render dashboard, not in this file.

# -- Database (required) ----------------------------------------------
# Create a free Turso/libSQL database:
#   turso db create clipforge
#   turso db show clipforge --url
#   turso db tokens create clipforge
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your-turso-token

# -- Blob storage (required) ------------------------------------------
# Browser uploads and rendered clips use Vercel Blob.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# -- Web process ------------------------------------------------------
# Render Free has 512 MB RAM, so keep the Whisper worker off the web box.
WORKER_DISABLED=1
CLIP_STORAGE=blob
WORK_ROOT=/tmp/work
CLIPS_ROOT=/tmp/clips
HF_HOME=/tmp/hf-cache
WHISPER_MODEL=base
POLL_SECONDS=3
MIN_CLIP_SECONDS=16
MAX_CLIP_SECONDS=52
TARGET_CLIP_SECONDS=30

# -- Local worker -----------------------------------------------------
# Run the worker on your machine (or another paid host) with the same
# DATABASE_URL, DATABASE_AUTH_TOKEN, and BLOB_READ_WRITE_TOKEN:
#   CLIP_STORAGE=blob
#   WORK_ROOT=.work/jobs
#   npm run worker
# Optional Khmer model path for the worker:
#   WHISPER_MODEL_KM=.models/faster-whisper-base-khmer

# -- Schema -----------------------------------------------------------
# The web process applies the committed Drizzle migrations before starting so
# a new Turso database gets its tables automatically. Set DB_AUTO_SETUP=0
# to skip it.

# -- Paid disk alternative --------------------------------------------
# A persistent disk requires a paid Render instance (for example 1c-2g).
# Attach 10 GB at /var/data, then use:
#   DATABASE_URL=file:/var/data/clipforge.db
#   WORK_ROOT=/var/data/work
#   CLIPS_ROOT=/var/data/clips
#   CLIP_STORAGE=local
# Remove WORKER_DISABLED to run the worker in the same container.
