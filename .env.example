# -- Database (SQLite) -----------------------------------------------
# Local SQLite file used by the app and drizzle-kit.
DATABASE_URL=file:./clipforge.db
# Only needed for Turso/libSQL over HTTP (e.g. libsql://...).
# DATABASE_AUTH_TOKEN=

# -- Vercel Blob -----------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# -- Worker ----------------------------------------------------------
# Whisper model size: tiny, base, small, medium, large (base is a good CPU default).
WHISPER_MODEL=base
# Optional CT2 folder for Khmer speech; build it with `npm run model:khmer`.
WHISPER_MODEL_KM=.models/faster-whisper-base-khmer
# Seconds between queue polls.
POLL_SECONDS=3
# Scratch directory for downloads and audio; removed after each job.
WORK_ROOT=.work/jobs
# Where rendered clips are written and served from (default: public/clips).
# CLIPS_ROOT=.work/clips
# Clip window bounds in seconds.
MIN_CLIP_SECONDS=16
MAX_CLIP_SECONDS=52
TARGET_CLIP_SECONDS=30
